<%- include('partials/head', { title }); %>
  <%- include('partials/header', { title, user, userId }); %>
  <div id="bodyoverlay"></div>
  
  <section id="deletewarning" class="card deletewarning">
    <h2>Are you sure you want to delete <span id="delete-target"></span>?</h2>
    <div class="confirmation">
      <button id="canceldel" class="button">No</button>
      <button id="confirmdel" class="button">Delete</button>
    </div>
  </section>
  <section id="editor" class="editor card">
    <svg id="close-editor" xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24" class="editor-close-btn" fill="currentColor">
      <path
        d="M 4.7070312 3.2929688 L 3.2929688 4.7070312 L 10.585938 12 L 3.2929688 19.292969 L 4.7070312 20.707031 L 12 13.414062 L 19.292969 20.707031 L 20.707031 19.292969 L 13.414062 12 L 20.707031 4.7070312 L 19.292969 3.2929688 L 12 10.585938 L 4.7070312 3.2929688 z">
      </path>
    </svg></button>

    <h1>Edit</h1>
    <form id="edit-form">
      <div class="input-group"><label for="title">Title: </label>
        <input name="title" type="text" placeholder="Title">
      </div>
      <div class="input-group"><label for="price">Price: </label>
        <input name="price" type="text" placeholder="Price">
      </div>
      <div class="input-group"><label for="description">Description: </label><input name="description" type="text"
          placeholder="Description"></div>
      <div class="input-group"><label for="image">Image URL: </label><input name="image" type="text"
          placeholder="URL for the image"></div>
      <div class="input-group"><label for="format">Format: </label>
        <select name="format">
          <option value="">Select a format</option>
          <option value="dvd">DVD</option>
          <option value="blu-ray">Blu-ray</option>
          <option value="vhs">VHS</option>
          <option value="laserdisc">LaserDisc</option>
          <option value="16mm-reel">16mm reel</option>
          <option value="digital">Digital</option>
        </select>
      </div>
      <div class="input-group"><label for="condition">Condition: </label>
        <select name="condition">
          <option value="">Select a condition</option>
          <option value="Mint">Mint</option>
          <option value="Near Mint">Near Mint</option>
          <option value="Very Good">Very Good</option>
          <option value="Fair">Fair</option>
          <option value="Poor">Poor</option>
        </select>
      </div>
      <div class="input-group"><label for="listingType">Listing type: </label>
        <select name="listingType">
          <option value="Sale">For sale</option>
          <option value="Trade">Open to trade</option>
          <option value="Both">Sale or trade</option>
        </select>
      </div>
      <div class="left-aligned"><input type="button" id="editSubmit" class="button"></div>
    </form>
  </section>

  <main class="page-content">
      <section class="dashboard-section" id="trades-section">
        <h2>Trades in progress</h2>
        <p class="dashboard-sub" id="trades-loading">Loading…</p>
        <ul class="trade-cards" id="trades-in-progress-list"></ul>
      </section>

      <section class="dashboard-section">
        <h2>Your movies</h2>
        <p class="dashboard-sub">
          <% if (movies.length) { %>
            <%= movies.length %> title<%= movies.length === 1 ? '' : 's' %> listed on the marketplace.
          <% } else { %>
            Nothing listed yet — add your first title below.
          <% } %>
        </p>
        <button class="add-btn">Add Movie<i class="add-icon"></i></button>
        <ul class="cards">
          <% if (!movies.length){ %>
            <h3 id="no-movies">No Movies. Create a new one</h3>
          <% } %>
          <% movies.forEach(function(movie){ %>
            <%- include('partials/moviecard', { movie: movie, id: movie.id, canModify: true }); %>
          <% }); %>
        </ul>
      </section>

      <section class="dashboard-section" id="trades-completed-section">
        <h2>Trades completed</h2>
        <p class="dashboard-sub" id="trades-completed-loading">Loading…</p>
        <ul class="cards" id="trades-completed-list"></ul>
      </section>

      <section class="dashboard-section" id="purchases-section">
        <h2>Purchases completed</h2>
        <p class="dashboard-sub" id="purchases-loading">Loading…</p>
        <ul class="cards" id="purchases-completed-list"></ul>
      </section>
  </main>
  <script src="/scripts/dashboard.js" defer></script>
<%- include('partials/footer'); %>