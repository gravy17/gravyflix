<%
  /*
    Card used in grid listings (index.ejs, dashboard.ejs).
    format / condition / listingType come straight from the Movie schema's
    enums -- optional fields just don't render rather than showing a fake
    value. createdBy.city / country_code / rating depend on the query
    populating createdBy; all degrade gracefully if absent.
  */
  const conditionGrade = { 'Mint': 5, 'Near Mint': 4, 'Very Good': 3, 'Fair': 2, 'Poor': 1 };
  const conditionFilled = movie.condition ? (conditionGrade[movie.condition] || 0) : 0;

  const formatSlug = movie.format
    ? movie.format.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
    : '';

  const openToTrade = movie.listingType === 'Trade' || movie.listingType === 'Both';
  const actionLabel = movie.listingType === 'Trade' ? 'Propose trade' : 'Buy now';

  const seller = (movie.createdBy && typeof movie.createdBy === 'object')
    ? (movie.createdBy.username || movie.createdBy.fullname)
    : null;
  const sellerCity = (movie.createdBy && typeof movie.createdBy === 'object') ? movie.createdBy.city : null;
  const sellerCountry = (movie.createdBy && typeof movie.createdBy === 'object') ? movie.createdBy.country_code : null;
  const sellerLocation = [sellerCity, sellerCountry].filter(Boolean).join(', ') || null;
  const sellerRating = (movie.createdBy && typeof movie.createdBy === 'object') ? movie.createdBy.rating : null;
  const sellerInitials = seller ? seller.replace(/[^A-Za-z]/g, '').slice(0, 2).toUpperCase() : 'GF';

  function timeAgo(date) {
    if (!date) return null;
    const diffMs = Date.now() - new Date(date).getTime();
    const day = Math.floor(diffMs / 86400000);
    if (day >= 30) { const mo = Math.floor(day / 30); return 'Listed ' + mo + ' month' + (mo === 1 ? '' : 's') + ' ago'; }
    if (day >= 1) return 'Listed ' + day + ' day' + (day === 1 ? '' : 's') + ' ago';
    const hr = Math.floor(diffMs / 3600000);
    if (hr >= 1) return 'Listed ' + hr + ' hour' + (hr === 1 ? '' : 's') + ' ago';
    return 'Listed today';
  }
  const listedAt = timeAgo(movie.createdAt);
  const catalogCode = movie.id ? String(movie.id).slice(-6).toUpperCase() : null;
  const isInactive = movie.active === false;
%>
<li data-key="<%= movie.id %>" data-format="<%= formatSlug %>" data-title="<%= movie.title %>" data-price="<%= movie.price %>" data-description="<%= movie.description || '' %>" data-image="<%= movie.image || '' %>" data-format-value="<%= movie.format || '' %>" data-condition="<%= movie.condition || '' %>" data-listing-type="<%= movie.listingType || '' %>">
  <a href="/<%= movie.id %>" class="card<%= isInactive ? ' card--inactive' : '' %>">
    <div class="card__media">
      <object data="<%= movie.image %>" type="image/jpeg" class="card__image">
        <img src="/images/default-movie.jpg" class="card__image" alt="Image for <%= movie.title %>" />
      </object>
      <% if (movie.format) { %>
        <span class="badge badge-format"><%= movie.format %></span>
      <% } %>
      <% if (!canModify && openToTrade) { %>
        <span class="badge badge-trade">Open to trade</span>
      <% } %>
    </div>
    <div class="card__content">
      <div class="card__heading">
        <div class="card__header-text">
          <% if (catalogCode) { %>
            <p class="movie__catalog">Cat. #<%= catalogCode %></p>
          <% } %>
          <h3 class="movie__title">
            <%= movie.title %>
          </h3>
        </div>
        <% if(canModify && !isInactive) { %>
          <span class="modifybtns">
            <button class="edit-btn" data-edit="<%= movie.id %>">
              <span>Edit</span><i class="edit-icon"></i>
            </button>
            <button class="delete-btn" data-delete="<%= movie.id %>">
              <span>Delete</span><i class="delete-icon"></i>
            </button>
          </span>
        <% } %>
      </div>
      <% if (movie.description) { %>
        <p class="movie__description">
          <%= movie.description %>
        </p>
      <% } %>
      <% if (movie.condition) { %>
        <div class="condition-row">
          <div class="condition-bar">
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="<%= i <= conditionFilled ? 'filled' : '' %>"></span>
            <% } %>
          </div>
          <span class="condition-label"><%= movie.condition %></span>
        </div>
      <% } %>
      <% if (!canModify && (seller || listedAt)) { %>
        <div class="seller-row">
          <% if (seller) { %><div class="avatar"><%= sellerInitials %></div><% } %>
          <div>
            <% if (seller) { %>
              <div class="seller-name">
                <%= seller %><% if (sellerLocation) { %> · <span class="seller-loc"><%= sellerLocation %></span><% } %>
                <% if (sellerRating) { %><span class="seller-rating"><%= sellerRating %>/100</span><% } %>
              </div>
            <% } %>
            <% if (listedAt) { %><div class="seller-meta"><%= listedAt %></div><% } %>
          </div>
        </div>
      <% } %>
      <div class="price-row">
        <span class="movie__price">₦<%= movie.price %></span>
        <% if (canModify) { %>
          <span class="status-pill<%= isInactive ? ' status-pill--sold' : '' %>"><%= isInactive ? 'Sold' : 'Live listing' %></span>
        <% } else { %>
          <span class="view-pill"><%= actionLabel %></span>
        <% } %>
      </div>
    </div>
  </a>
</li>
